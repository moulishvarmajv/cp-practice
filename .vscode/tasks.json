{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ with GCC 16",
      "type": "process",
      "command": "/opt/homebrew/bin/g++-16",
      "args": [
        "-isysroot",
        "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
        "-std=c++17",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/bin/${fileBasenameNoExtension}"
      ],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
